/* Base Font and Layout */
body {
  font-family: 'Open Sans', Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  margin: 0;
  padding: 0;
  background-color: #fff;
  color: #333;
}

/* Container for consistent page padding */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem;
}

/* Navigation Bar */
.navbar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 60px;
  background-color: #333;
  padding: 0 1rem;
  flex-wrap: wrap;
}

.navbar a {
  color: #fff;
  text-decoration: none;
  margin-right: 1rem;
  font-size: 1rem;
  padding: 0.5rem 0;
}

.navbar a:hover {
  text-decoration: underline;
}

/* Headings */
h1, h2, h3 {
  margin-top: 1.5rem;
  margin-bottom: 1rem;
  font-weight: 600;
  color: #222;
}

/* Paragraphs */
p {
  margin-bottom: 1rem;
}

/* Mobile Responsiveness */
@media (max-width: 600px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
    height: auto;
    padding: 0.5rem;
  }

  .navbar a {
    margin: 0.25rem 0;
    font-size: 1.1rem;
  }

  .container {
    padding: 0.5rem;
  }

  h1 {
    font-size: 1.8rem;
  }

  p {
    font-size: 1rem;
  }
}

